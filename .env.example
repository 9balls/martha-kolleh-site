# Copy this file to .env and fill in real values before running the server.
# Never commit the real .env file anywhere public.

# Port the server listens on
PORT=3000

# Admin login username
ADMIN_USERNAME=martha-admin

# Admin password hash — do NOT put a plain password here.
# Generate this by running: npm run set-password
# (it will ask you to type a password and print the hash to paste below)
ADMIN_PASSWORD_HASH=

# Long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Public site URL, used for canonical link / sitemap / structured data
SITE_URL=https://www.marthakolleh.com
