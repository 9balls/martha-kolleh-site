<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= data.bio.fullName %> | Liberian <%= data.bio.positions.join(' & ') %> — Official Player Profile</title>
<meta name="description" content="Official player profile of <%= data.bio.fullName %>, Liberian <%= data.bio.positions.join(' / ').toLowerCase() %>. Career history, club statistics, and scouting contact.">
<meta name="robots" content="index, follow">
<% if (siteUrl) { %><link rel="canonical" href="<%= siteUrl %>/"><% } %>

<meta property="og:type" content="profile">
<meta property="og:title" content="<%= data.bio.fullName %> | Liberian <%= data.bio.positions.join(' & ') %>">
<meta property="og:description" content="Official player profile: career history, statistics, and scouting contact.">
<% if (data.gallery[0]) { %><meta property="og:image" content="/public/uploads/gallery/<%= data.gallery[0].filename %>"><% } %>
<meta name="twitter:card" content="summary_large_image">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/public/css/style.css">

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "<%= data.bio.fullName %>",
  "birthDate": "<%= data.bio.dateOfBirth %>",
  "birthPlace": "<%= data.bio.placeOfBirth %>",
  "nationality": { "@type": "Country", "name": "<%= data.bio.nationality %>" },
  "gender": "Female",
  "jobTitle": "Professional Football Player",
  "memberOf": [{ "@type": "SportsTeam", "name": "<%= data.bio.currentClub %>", "sport": "Football" }],
  "description": <%- JSON.stringify(data.bio.summary) %>
}
</script>
</head>
<body>

<a class="skip-link" href="#main">Skip to content</a>

<header class="site-header">
  <div class="wrap header-row">
    <span class="wordmark"><%= data.bio.fullName.toUpperCase() %></span>
    <nav aria-label="Primary">
      <button class="nav-toggle" aria-expanded="false" aria-controls="nav-menu">
        <span></span><span></span><span></span>
      </button>
      <ul id="nav-menu">
        <li><a href="#passport">Passport</a></li>
        <li><a href="#journey">Journey</a></li>
        <li><a href="#stats">Statistics</a></li>
        <li><a href="#national">National Team</a></li>
        <li><a href="#gallery">Gallery</a></li>
        <% if (data.reels.length) { %><li><a href="#reels">Reels</a></li><% } %>
        <li><a href="#contact" class="nav-cta">Scouting Contact</a></li>
      </ul>
    </nav>
  </div>
</header>

<main id="main">

  <section class="hero" id="passport">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Player Profile — <%= data.bio.positions.join(' / ') %></p>
        <h1><%- data.bio.fullName.split(' ').join('<br>') %></h1>
        <p class="hero-sub"><%= data.bio.positions[0] %>. Currently signed with <%= data.bio.currentClub %><% if (data.bio.contractLength) { %> — <%= data.bio.contractLength %><% } %>, <%= data.bio.nationality %>.</p>
        <div class="hero-cta-row">
          <a href="#contact" class="btn btn-primary">Scouting &amp; Contract Inquiries</a>
          <a href="#stats" class="btn btn-ghost">View Statistics</a>
        </div>
      </div>

      <div class="passport-card">
        <div class="passport-top">
          <span class="passport-label">PLAYER PASSPORT</span>
          <% if (data.bio.jerseyNumber) { %><span class="passport-number">#<%= data.bio.jerseyNumber %></span><% } %>
          <span class="passport-flag">LBR</span>
        </div>
        <% if (data.gallery[0]) { %>
        <div class="passport-photo">
          <img src="/public/uploads/gallery/<%= data.gallery[0].filename %>" alt="<%= data.gallery[0].alt %>">
        </div>
        <% } %>
        <dl class="passport-fields">
          <div><dt>Name</dt><dd><%= data.bio.fullName %></dd></div>
          <% if (data.bio.jerseyNumber) { %><div><dt>Jersey Number</dt><dd>#<%= data.bio.jerseyNumber %></dd></div><% } %>
          <div><dt>Position</dt><dd><%= data.bio.positions.join(' / ') %></dd></div>
          <div><dt>Nationality</dt><dd><%= data.bio.nationality %></dd></div>
          <div><dt>Current Club</dt><dd><%= data.bio.currentClub %></dd></div>
          <div><dt>Date of Birth</dt><dd><%= data.bio.dateOfBirth ? new Date(data.bio.dateOfBirth).toLocaleDateString('en-GB', {day:'numeric',month:'long',year:'numeric'}) : '—' %></dd></div>
          <div><dt>Place of Birth</dt><dd><%= data.bio.placeOfBirth || '—' %></dd></div>
          <div><dt>County of Origin</dt><dd><%= data.bio.countyOfOrigin || '—' %></dd></div>
          <div><dt>Preferred Foot</dt><dd><%= data.bio.preferredFoot || '—' %></dd></div>
          <div><dt>Height</dt><dd><%= data.bio.height || '—' %></dd></div>
          <div><dt>Contract</dt><dd><%= data.bio.contractLength || '—' %></dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="journey" id="journey">
    <div class="wrap">
      <p class="eyebrow">Career Path</p>
      <h2>The Journey So Far</h2>
      <ol class="timeline">
        <% data.career.forEach((step, i) => { %>
        <li class="timeline-item <%= step.current ? 'timeline-current' : '' %>">
          <span class="timeline-num"><%= String(i + 1).padStart(2, '0') %></span>
          <div>
            <h3><%= step.title %> <% if (step.current) { %><span class="tag-current">Current</span><% } %></h3>
            <p><%= step.note %></p>
          </div>
        </li>
        <% }) %>
      </ol>
    </div>
  </section>

  <section class="stats" id="stats">
    <div class="wrap">
      <p class="eyebrow">Season Log</p>
      <h2>Club Statistics</h2>
      <p class="stats-note">Updated after each completed match round.</p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Season</th><th scope="col">Club</th><th scope="col">Competition</th>
              <th scope="col">Apps</th><th scope="col">Goals</th><th scope="col">Assists</th><th scope="col">Clean Sheets</th>
            </tr>
          </thead>
          <tbody>
            <% data.stats.forEach(row => { %>
            <tr>
              <td data-label="Season"><%= row.season || '—' %></td>
              <td data-label="Club"><%= row.club || '—' %></td>
              <td data-label="Competition"><%= row.competition || '—' %></td>
              <td data-label="Apps"><%= row.apps || '—' %></td>
              <td data-label="Goals"><%= row.goals || '—' %></td>
              <td data-label="Assists"><%= row.assists || '—' %></td>
              <td data-label="Clean Sheets"><%= row.cleanSheets || '—' %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="national" id="national">
    <div class="wrap national-grid">
      <div>
        <p class="eyebrow">International</p>
        <h2>Liberia Women's National Team</h2>
        <p><%= data.nationalTeam.note %></p>
      </div>
      <dl class="stat-chips">
        <div class="chip"><dt>Caps</dt><dd><%= data.nationalTeam.caps || '—' %></dd></div>
        <div class="chip"><dt>Debut</dt><dd><%= data.nationalTeam.debut || '—' %></dd></div>
        <div class="chip"><dt>Goals</dt><dd><%= data.nationalTeam.goals || '—' %></dd></div>
      </dl>
    </div>
  </section>

  <section class="gallery" id="gallery">
    <div class="wrap">
      <p class="eyebrow">Match Action</p>
      <h2>Gallery</h2>
      <div class="gallery-grid">
        <% data.gallery.forEach(img => { %>
        <figure>
          <img src="/public/uploads/gallery/<%= img.filename %>" alt="<%= img.alt %>" loading="lazy">
        </figure>
        <% }) %>
      </div>
    </div>
  </section>

  <% if (data.reels.length) { %>
  <section class="gallery" id="reels" style="background:#fff;">
    <div class="wrap">
      <p class="eyebrow">Highlights</p>
      <h2>Reels</h2>
      <div class="gallery-grid">
        <% data.reels.forEach(reel => { %>
        <figure>
          <% if (reel.type === 'upload') { %>
            <video controls preload="metadata" style="width:100%;height:100%;object-fit:cover;">
              <source src="/public/uploads/reels/<%= reel.src %>">
            </video>
          <% } else { %>
            <a href="<%= reel.src %>" target="_blank" rel="noopener" style="display:flex;align-items:center;justify-content:center;height:100%;background:var(--ink);color:var(--bone);text-decoration:none;font-family:var(--mono);font-size:13px;text-align:center;padding:16px;">
              Watch reel ↗
            </a>
          <% } %>
          <% if (reel.caption) { %><figcaption style="padding:8px 4px;font-size:13px;color:var(--steel);"><%= reel.caption %></figcaption><% } %>
        </figure>
        <% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <section class="contact" id="contact">
    <div class="wrap contact-grid">
      <div>
        <p class="eyebrow">For Clubs &amp; Agents</p>
        <h2>Scouting &amp; Contract Inquiries</h2>
        <p>Serious inquiries from licensed clubs and agents are welcome through the channels below.</p>
      </div>
      <dl class="contact-fields">
        <% if (data.contact.email) { %><div><dt>Email</dt><dd><a href="mailto:<%= data.contact.email %>"><%= data.contact.email %></a></dd></div><% } %>
        <% if (data.contact.whatsapp) { %><div><dt>WhatsApp</dt><dd><%= data.contact.whatsapp %></dd></div><% } %>
        <% if (data.contact.basedIn) { %><div><dt>Based in</dt><dd><%= data.contact.basedIn %></dd></div><% } %>
      </dl>
    </div>
  </section>

</main>

<footer class="site-footer">
  <div class="wrap">
    <p>&copy; <span id="year"></span> <%= data.bio.fullName %>. Official player profile.</p>
  </div>
</footer>

<script src="/public/js/script.js"></script>
</body>
</html>
